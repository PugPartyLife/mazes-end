---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation";
import Footer from "../../components/Footer";
import { getAllGuides } from "../../lib/strapi/strapi";
import type { Guide } from "../../types/guide";

// Fetch guides from Strapi
const { data: guides } = await getAllGuides();
---

<Layout title="Guides - The Maze's End">
  <div class="min-h-screen bg-gray-900">
    <Navigation client:idle />
    
    <section class="py-20 bg-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold text-white mb-12 text-center">
          cEDH <span class="text-yellow-400 font-serif">Guides</span>
          </span>
        </h1>
        
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {guides.map((guide: Guide) => {
            const coverUrl = guide.coverImage?.url 
              ? (guide.coverImage.url.startsWith('http') ? guide.coverImage.url : `http://localhost:1337${guide.coverImage.url}`)
              : null;
              
            return (
              <article class="bg-gray-700 rounded-lg overflow-hidden hover:bg-gray-600 transition-colors">
                {coverUrl && (
                  <img 
                    src={coverUrl} 
                    alt={guide.coverImage?.alternativeText || guide.title}
                    class="w-full h-48 object-cover"
                  />
                )}
                <div class="p-6">
                  <div class="flex items-center gap-3 text-xs text-gray-400 mb-3">
                    {guide.category && (
                      <span class="bg-gray-800 px-2 py-1 rounded">
                        {guide.category}
                      </span>
                    )}
                    {guide.readingTime && (
                      <span>{guide.readingTime} min read</span>
                    )}
                  </div>
                  
                  <h2 class="text-xl font-bold text-white mb-3">
                    <a href={`/guides/${guide.slug}`} class="hover:text-yellow-400 transition-colors">
                      {guide.title}
                    </a>
                  </h2>
                  
                  {guide.description && (
                    <p class="text-gray-300 mb-4 line-clamp-3">{guide.description}</p>
                  )}
                  
                  <a 
                    href={`/guides/${guide.slug}`} 
                    class="inline-block mt-4 text-yellow-400 hover:underline"
                  >
                    Read guide →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
        
        {guides.length === 0 && (
          <p class="text-center text-gray-400 text-lg">No guides yet. Check back soon!</p>
        )}
      </div>
    </section>
  </div>
  
  <Footer />
</Layout>